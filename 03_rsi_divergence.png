            <tr><td>8</td><td><a href="#estrategia-8" class="table-link">Volume Profile</a></td><td><span class="wr-badge wr-medium">47–67%</span></td><td>H1, H4</td><td>1:2</td><td><span class="diff-medium">Media</span></td></tr>
            <tr><td>9</td><td><a href="#estrategia-9" class="table-link">Breakout y Retest</a></td><td><span class="wr-badge wr-medium">45–65%</span></td><td>H1, H4</td><td>1:2</td><td><span class="diff-easy">Baja</span></td></tr>
