/* ============================================================
   MANUAL DE TRADING DE ORO — Stylesheet
   Dark mode primary (Bloomberg/TradingView aesthetic)
   Gold accent + Teal secondary
   ============================================================ */

/* ===== CSS Custom Properties ===== */
:root {
  /* Fonts */
  --font-display: 'Cabinet Grotesk', 'Helvetica Neue', sans-serif;
  --font-body: 'Satoshi', 'Helvetica Neue', sans-serif;

  /* Type scale */
  --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
  --text-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem);
  --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
  --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
  --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2.25rem);
  --text-2xl: clamp(2rem, 1.2rem + 2.5vw, 3.5rem);
  --text-3xl: clamp(2.5rem, 1rem + 4vw, 5rem);
  --text-hero: clamp(3rem, 0.5rem + 7vw, 8rem);

  /* 4px spacing system */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;
  --space-24: 6rem;
  --space-32: 8rem;

  /* Radius */
  --radius-sm: 0.375rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
  --radius-full: 9999px;

  /* Transitions */
  --transition-interactive: 180ms cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 320ms cubic-bezier(0.16, 1, 0.3, 1);

  /* Sidebar width */
  --sidebar-width: 280px;
}

/* ===== Dark Theme (Default) — Rojo intenso sobre negro puro ===== */
[data-theme='dark'] {
  --color-bg: #0A0A0A;
  --color-surface: #121212;
  --color-surface-2: #161616;
  --color-surface-offset: #1B1B1B;
  --color-surface-dynamic: #262626;
  --color-divider: #232323;
  --color-border: #333333;

  --color-text: #F2F1EF;
  --color-text-muted: #9C9B99;
  --color-text-faint: #636261;
  --color-text-inverse: #0A0A0A;

  /* Acento primario: rojo intenso (antes gold) */
  --color-gold: #FF1E3C;
  --color-gold-hover: #FF4D66;
  --color-gold-active: #FF7A8C;
  --color-gold-highlight: #3D1015;

  /* Acento secundario: gris acero (antes teal) */
  --color-teal: #B4B3B1;
  --color-teal-hover: #E0DFDD;
  --color-teal-highlight: #2A2A2A;

  --color-green: #4CBB63;
  --color-green-highlight: #1C2E20;
  --color-red: #FF3B54;
  --color-red-highlight: #3A1218;
  --color-orange: #FF8A3D;
  --color-orange-highlight: #3D2515;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.5);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.6);
  --shadow-lg: 0 14px 36px rgba(0, 0, 0, 0.7);
  --shadow-gold: 0 4px 22px rgba(255, 30, 60, 0.25);
}

/* ===== Light Theme — Rojo sobre blanco/gris ===== */
[data-theme='light'] {
  --color-bg: #FAFAFA;
  --color-surface: #FFFFFF;
  --color-surface-2: #FFFFFF;
  --color-surface-offset: #F1F1F1;
  --color-surface-dynamic: #E7E7E7;
  --color-divider: #E2E2E2;
  --color-border: #D2D2D2;

  --color-text: #141414;
  --color-text-muted: #6B6B6A;
  --color-text-faint: #AFAEAC;
  --color-text-inverse: #FFFFFF;

  --color-gold: #D40E2C;
  --color-gold-hover: #B10A24;
  --color-gold-active: #8C0A1D;
  --color-gold-highlight: #FBDBDF;

  --color-teal: #5C5C5A;
  --color-teal-hover: #3D3D3B;
  --color-teal-highlight: #E7E7E5;

  --color-green: #2E7D42;
  --color-green-highlight: #DCEFDF;
  --color-red: #C31432;
  --color-red-highlight: #FBDADE;
  --color-orange: #C9600F;
  --color-orange-highlight: #F5E1CE;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.14);
  --shadow-gold: 0 4px 20px rgba(212, 14, 44, 0.18);
}

/* System preference fallback */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --color-bg: #0A0A0A;
    --color-surface: #121212;
    --color-surface-2: #161616;
    --color-surface-offset: #1B1B1B;
    --color-surface-dynamic: #262626;
    --color-divider: #232323;
    --color-border: #333333;
    --color-text: #F2F1EF;
    --color-text-muted: #9C9B99;
    --color-text-faint: #636261;
    --color-text-inverse: #0A0A0A;
    --color-gold: #FF1E3C;
    --color-gold-hover: #FF4D66;
    --color-gold-active: #FF7A8C;
    --color-gold-highlight: #3D1015;
    --color-teal: #B4B3B1;
    --color-teal-hover: #E0DFDD;
    --color-teal-highlight: #2A2A2A;
    --color-green: #4CBB63;
    --color-green-highlight: #1C2E20;
    --color-red: #FF3B54;
    --color-red-highlight: #3A1218;
    --color-orange: #FF8A3D;
    --color-orange-highlight: #3D2515;
  }
}

/* ===== Reset ===== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  -webkit-text-size-adjust: none;
  text-size-adjust: none;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
  scroll-padding-top: var(--space-8);
}

body {
  min-height: 100dvh;
  line-height: 1.65;
  font-family: var(--font-body);
  font-size: var(--text-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  transition: background-color var(--transition-smooth), color var(--transition-smooth);
}

img, picture, video, canvas, svg {
  display: block;
  max-width: 100%;
  height: auto;
}

ul, ol {
  list-style: none;
}

input, button, textarea, select {
  font: inherit;
  color: inherit;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  text-wrap: balance;
  line-height: 1.15;
  font-weight: 700;
}

p, li, figcaption {
  text-wrap: pretty;
  max-width: 72ch;
}

a {
  color: var(--color-gold);
  text-decoration: none;
  transition: color var(--transition-interactive);
}

a:hover {
  color: var(--color-gold-hover);
}

::selection {
  background: color-mix(in oklab, var(--color-gold) 30%, transparent);
  color: var(--color-text);
}

:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 3px;
  border-radius: var(--radius-sm);
}

table {
  border-collapse: collapse;
  width: 100%;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* ============================================================
   SCROLL REVEAL ANIMATIONS
   ============================================================ */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
              transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
}

.reveal.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Stagger delays for grid children */
.reveal-stagger > * {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
              transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
}

.reveal-stagger.revealed > *:nth-child(1) { transition-delay: 0ms; }
.reveal-stagger.revealed > *:nth-child(2) { transition-delay: 80ms; }
.reveal-stagger.revealed > *:nth-child(3) { transition-delay: 160ms; }
.reveal-stagger.revealed > *:nth-child(4) { transition-delay: 240ms; }
.reveal-stagger.revealed > *:nth-child(5) { transition-delay: 320ms; }
.reveal-stagger.revealed > *:nth-child(6) { transition-delay: 400ms; }
.reveal-stagger.revealed > *:nth-child(7) { transition-delay: 480ms; }
.reveal-stagger.revealed > *:nth-child(8) { transition-delay: 560ms; }
.reveal-stagger.revealed > *:nth-child(9) { transition-delay: 640ms; }
.reveal-stagger.revealed > *:nth-child(10) { transition-delay: 720ms; }

.reveal-stagger.revealed > * {
  opacity: 1;
  transform: translateY(0);
}

/* ============================================================
   NAV GROUP (Collapsible Estrategias)
   ============================================================ */
.nav-group {
  margin-top: var(--space-2);
  margin-bottom: var(--space-2);
}

.nav-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: var(--space-2) var(--space-3);
  border: none;
  background: transparent;
  color: var(--color-text-faint);
  font-family: var(--font-display);
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
  transition: color var(--transition-interactive);
}

.nav-group-header:hover {
  color: var(--color-gold);
}

.nav-group-chevron {
  transition: transform var(--transition-smooth);
  flex-shrink: 0;
}

.nav-group-header[aria-expanded="false"] .nav-group-chevron {
  transform: rotate(-90deg);
}

.nav-group-items {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
  max-height: 600px;
  transition: max-height 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease;
  opacity: 1;
}

.nav-group-header[aria-expanded="false"] + .nav-group-items {
  max-height: 0;
  opacity: 0;
}

.nav-sub {
  padding-left: var(--space-6);
  font-size: var(--text-xs);
}

/* ============================================================
   SCROLL PROGRESS BAR
   ============================================================ */
.scroll-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  width: 0%;
  background: linear-gradient(90deg, var(--color-gold), var(--color-teal));
  z-index: 1000;
  transition: width 80ms linear;
  box-shadow: 0 0 8px color-mix(in oklab, var(--color-gold) 50%, transparent);
}

/* ============================================================
   SIDEBAR
   ============================================================ */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: var(--sidebar-width);
  height: 100dvh;
  background-color: var(--color-surface);
  border-right: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  z-index: 100;
  transition: transform var(--transition-smooth);
}

.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-6) var(--space-5);
  border-bottom: 1px solid var(--color-border);
  flex-shrink: 0;
}

.logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  color: var(--color-text);
}

.logo:hover {
  color: var(--color-text);
}

.logo-icon {
  width: 32px;
  height: 32px;
  color: var(--color-gold);
  flex-shrink: 0;
}

.logo-text {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: var(--text-lg);
  letter-spacing: -0.02em;
}

.logo-accent {
  color: var(--color-gold);
  margin-left: 2px;
}

.sidebar-close {
  display: none;
  color: var(--color-text-muted);
  padding: var(--space-2);
  border-radius: var(--radius-md);
  align-items: center;
  justify-content: center;
}

.sidebar-close:hover {
  color: var(--color-text);
  background-color: var(--color-surface-offset);
}

.sidebar-nav {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-4) var(--space-3);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sidebar-nav::-webkit-scrollbar {
  width: 6px;
}

.sidebar-nav::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar-nav::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: var(--radius-full);
}

.nav-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  font-weight: 500;
  transition: all var(--transition-interactive);
  border-left: 3px solid transparent;
  line-height: 1.4;
}

.nav-link:hover {
  color: var(--color-text);
  background-color: var(--color-surface-offset);
}

.nav-link.active {
  color: var(--color-gold);
  background-color: var(--color-gold-highlight);
  border-left-color: var(--color-gold);
  font-weight: 700;
}

.nav-num {
  font-family: var(--font-display);
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  font-weight: 700;
  min-width: 24px;
  transition: color var(--transition-interactive);
}

.nav-link.active .nav-num {
  color: var(--color-gold);
}

.nav-flagship {
  color: var(--color-gold) !important;
  font-weight: 700 !important;
}

.nav-flagship .nav-num {
  color: var(--color-gold);
}

.sidebar-footer {
  padding: var(--space-4) var(--space-5);
  border-top: 1px solid var(--color-border);
  flex-shrink: 0;
}

/* ============================================================
   THEME TOGGLE
   ============================================================ */
.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  background-color: var(--color-surface-offset);
  border: 1px solid var(--color-border);
  transition: all var(--transition-interactive);
}

.theme-toggle:hover {
  color: var(--color-gold);
  border-color: var(--color-gold);
}

[data-theme='dark'] .icon-sun,
[data-theme='light'] .icon-moon {
  display: none;
}

[data-theme='dark'] .icon-moon,
[data-theme='light'] .icon-sun {
  display: block;
}

/* ============================================================
   MOBILE TOPBAR
   ============================================================ */
.mobile-topbar {
  display: none;
  position: sticky;
  top: 0;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  background-color: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  z-index: 90;
  backdrop-filter: blur(12px);
}

.hamburger {
  color: var(--color-text);
  padding: var(--space-2);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hamburger:hover {
  background-color: var(--color-surface-offset);
}

.mobile-title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-sm);
  color: var(--color-text);
}

.theme-toggle-mobile {
  width: 36px;
  height: 36px;
}

.sidebar-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 99;
  opacity: 0;
  transition: opacity var(--transition-smooth);
}

.sidebar-overlay.active {
  display: block;
  opacity: 1;
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */
.main-content {
  margin-left: var(--sidebar-width);
  min-height: 100dvh;
  transition: margin var(--transition-smooth);
}

/* ============================================================
   SECTIONS
   ============================================================ */
.section {
  padding: var(--space-16) var(--space-12);
  max-width: 1100px;
  border-bottom: 1px solid var(--color-divider);
}

.section-header {
  margin-bottom: var(--space-10);
}

.section-label {
  display: inline-block;
  font-family: var(--font-display);
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-gold);
  margin-bottom: var(--space-3);
}

.section-label-gold {
  color: var(--color-gold);
  background: var(--color-gold-highlight);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
}

.section-title {
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: var(--space-4);
  letter-spacing: -0.02em;
}

.section-intro {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  max-width: 65ch;
  line-height: 1.7;
}

.subsection-title {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-top: var(--space-12);
  margin-bottom: var(--space-5);
  padding-bottom: var(--space-3);
  border-bottom: 2px solid var(--color-gold);
  display: inline-block;
}

/* ============================================================
   HERO SECTION
   ============================================================ */
.hero-section {
  min-height: 90dvh;
  display: flex;
  align-items: center;
  background: radial-gradient(ellipse at 70% 30%, var(--color-gold-highlight) 0%, transparent 50%),
              radial-gradient(ellipse at 20% 80%, var(--color-teal-highlight) 0%, transparent 50%),
              var(--color-bg);
  padding: var(--space-24) var(--space-12);
  border-bottom: 1px solid var(--color-border);
  position: relative;
  overflow: hidden;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -20%;
  width: 70%;
  height: 200%;
  background: radial-gradient(ellipse at center, color-mix(in oklab, var(--color-gold) 8%, transparent) 0%, transparent 60%);
  animation: heroFloat 12s ease-in-out infinite alternate;
  pointer-events: none;
}

.hero-section::after {
  content: '';
  position: absolute;
  bottom: -30%;
  right: -10%;
  width: 60%;
  height: 160%;
  background: radial-gradient(ellipse at center, color-mix(in oklab, var(--color-teal) 6%, transparent) 0%, transparent 60%);
  animation: heroFloat 15s ease-in-out infinite alternate-reverse;
  pointer-events: none;
}

@keyframes heroFloat {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(40px, -30px) scale(1.1); }
}

.hero-content {
  max-width: 700px;
}

.hero-eyebrow {
  display: inline-block;
  font-family: var(--font-display);
  font-size: var(--text-sm);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-gold);
  margin-bottom: var(--space-5);
  padding: var(--space-2) var(--space-4);
  border: 1px solid var(--color-gold);
  border-radius: var(--radius-full);
}

.hero-title {
  font-size: var(--text-3xl);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--color-text);
  margin-bottom: var(--space-5);
}

.hero-title-accent {
  color: var(--color-gold);
  text-shadow: 0 0 40px color-mix(in oklab, var(--color-gold) 30%, transparent);
}

.hero-subtitle {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 500;
  color: var(--color-teal);
  margin-bottom: var(--space-6);
  letter-spacing: -0.01em;
}

.hero-description {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  line-height: 1.8;
  margin-bottom: var(--space-8);
  max-width: 60ch;
}

.hero-badges {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-8);
  flex-wrap: wrap;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.hero-badge strong {
  color: var(--color-gold);
  font-family: var(--font-display);
  font-weight: 800;
}

.hero-disclaimer {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  line-height: 1.6;
  padding: var(--space-4) var(--space-5);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 3px solid var(--color-orange);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-8);
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-8);
  background-color: var(--color-gold);
  color: var(--color-bg);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-base);
  border-radius: var(--radius-md);
  transition: all var(--transition-interactive);
  box-shadow: var(--shadow-gold);
  position: relative;
  overflow: hidden;
}

.hero-cta::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-bg) 20%, transparent), transparent);
  transition: left 600ms ease;
}

.hero-cta:hover::before {
  left: 100%;
}

.hero-cta:hover {
  background-color: var(--color-gold-hover);
  color: var(--color-bg);
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
}

/* ============================================================
   TABLES
   ============================================================ */
.table-wrapper {
  overflow-x: auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  margin-bottom: var(--space-6);
  background-color: var(--color-surface);
}

.data-table {
  font-size: var(--text-sm);
}

.data-table thead {
  background-color: var(--color-surface-offset);
}

.data-table th {
  text-align: left;
  padding: var(--space-3) var(--space-4);
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--color-text);
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}

.data-table td {
  padding: var(--space-3) var(--space-4);
  color: var(--color-text-muted);
  border-bottom: 1px solid var(--color-divider);
}

.data-table tbody tr:last-child td {
  border-bottom: none;
}

.data-table tbody tr:hover {
  background-color: var(--color-surface-offset);
}

.data-table-compact th,
.data-table-compact td {
  padding: var(--space-2) var(--space-3);
}

.table-link {
  color: var(--color-gold);
  font-weight: 500;
}

.table-link:hover {
  text-decoration: underline;
}

.table-caption {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  margin-top: var(--space-2);
  margin-bottom: var(--space-8);
}

/* Cell color coding */
.cell-loss { color: var(--color-red); font-weight: 600; }
.cell-profit { color: var(--color-green); font-weight: 600; }
.cell-neutral { color: var(--color-text-muted); font-weight: 600; }

/* ============================================================
   WIN RATE BADGES
   ============================================================ */
.wr-badge {
  display: inline-flex;
  align-items: center;
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 700;
  font-family: var(--font-display);
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.wr-high {
  background-color: var(--color-green-highlight);
  color: var(--color-green);
  border: 1px solid var(--color-green);
}

.wr-medium {
  background-color: var(--color-gold-highlight);
  color: var(--color-gold);
  border: 1px solid var(--color-gold);
}

.wr-low {
  background-color: var(--color-orange-highlight);
  color: var(--color-orange);
  border: 1px solid var(--color-orange);
}

.wr-badge-lg {
  font-size: var(--text-sm);
  padding: var(--space-2) var(--space-4);
}

/* Difficulty badges */
.diff-easy { color: var(--color-green); font-weight: 600; }
.diff-medium { color: var(--color-gold); font-weight: 600; }
.diff-hard { color: var(--color-red); font-weight: 600; }

/* ============================================================
   CARDS & GRIDS
   ============================================================ */
.card-grid {
  display: grid;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.card-grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.card-grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.info-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth), transform var(--transition-smooth);
  position: relative;
  overflow: hidden;
}

.info-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  opacity: 0;
  transition: opacity var(--transition-smooth);
}

.info-card:hover {
  border-color: var(--color-gold);
  box-shadow: var(--shadow-md), 0 0 0 1px color-mix(in oklab, var(--color-gold) 20%, transparent);
  transform: translateY(-3px);
}

.info-card:hover::after {
  opacity: 1;
}

.info-card-accent {
  border-top: 3px solid var(--color-gold);
}

.info-card-title {
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-3);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.info-card-value {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-gold);
  margin-bottom: var(--space-2);
  letter-spacing: -0.02em;
}

.info-card-text {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* ============================================================
   CALLOUTS & FORMULAS
   ============================================================ */
.callout {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-teal);
  border-radius: var(--radius-md);
  padding: var(--space-5) var(--space-6);
  margin-bottom: var(--space-6);
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: 1.7;
}

.callout-gold {
  border-left-color: var(--color-gold);
}

.callout strong {
  color: var(--color-gold);
}

.formula-card {
  background-color: var(--color-surface-offset);
  border: 1px dashed var(--color-gold);
  border-radius: var(--radius-md);
  padding: var(--space-5) var(--space-6);
  margin-bottom: var(--space-6);
  text-align: center;
}

.formula-text {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-gold);
  letter-spacing: -0.01em;
}

/* ============================================================
   BULLET LISTS & RULES LISTS
   ============================================================ */
.bullet-list {
  list-style: none;
  padding: 0;
}

.bullet-list li {
  position: relative;
  padding-left: var(--space-5);
  margin-bottom: var(--space-2);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  line-height: 1.6;
}

.bullet-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.6em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--color-gold);
}

.bullet-list li strong {
  color: var(--color-text);
}

.rules-list {
  list-style: none;
  padding: 0;
  counter-reset: rule-counter;
}

.rules-list li {
  position: relative;
  padding-left: var(--space-8);
  margin-bottom: var(--space-3);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  line-height: 1.65;
  counter-increment: rule-counter;
}

.rules-list li::before {
  content: counter(rule-counter);
  position: absolute;
  left: 0;
  top: 0;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-gold-highlight);
  color: var(--color-gold);
  border-radius: var(--radius-full);
  font-family: var(--font-display);
  font-size: var(--text-xs);
  font-weight: 700;
  flex-shrink: 0;
}

.rules-list li strong {
  color: var(--color-text);
}

.rules-list-detailed li {
  padding-left: var(--space-10);
  margin-bottom: var(--space-4);
  font-size: var(--text-base);
  line-height: 1.7;
}

.rules-list-detailed li::before {
  width: 28px;
  height: 28px;
  font-size: var(--text-sm);
}

/* ============================================================
   STRATEGY CARDS
   ============================================================ */
.strategy-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: box-shadow var(--transition-smooth), border-color var(--transition-smooth);
}

.strategy-card:hover {
  box-shadow: var(--shadow-lg), 0 0 0 1px color-mix(in oklab, var(--color-gold) 15%, transparent);
}

.strategy-card-flagship {
  border: 2px solid var(--color-gold);
  box-shadow: var(--shadow-gold), var(--shadow-lg);
}

.strategy-header {
  padding: var(--space-8) var(--space-8) var(--space-6);
  background: linear-gradient(180deg, var(--color-surface-offset) 0%, var(--color-surface) 100%);
  border-bottom: 1px solid var(--color-border);
}

.strategy-card-flagship .strategy-header {
  background: linear-gradient(180deg, var(--color-gold-highlight) 0%, var(--color-surface) 100%);
}

.strategy-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-bottom: var(--space-3);
}

.strategy-title-row .section-title {
  margin-bottom: 0;
}

.strategy-body {
  padding: var(--space-8);
}

.strategy-block {
  margin-bottom: var(--space-8);
}

.strategy-block-gold {
  background-color: var(--color-surface-offset);
  border: 1px solid var(--color-gold);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}

.strategy-block-highlight {
  background-color: var(--color-surface-offset);
  border-left: 4px solid var(--color-teal);
  border-radius: var(--radius-md);
  padding: var(--space-5) var(--space-6);
}

.block-title {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-gold);
  margin-bottom: var(--space-4);
  font-family: var(--font-display);
  letter-spacing: -0.01em;
}

.strategy-block p {
  font-size: var(--text-base);
  color: var(--color-text);
  line-height: 1.7;
  margin-bottom: var(--space-3);
}

.strategy-block p strong {
  color: var(--color-gold);
}

/* Pros & Cons */
.strategy-pros-cons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  background-color: var(--color-surface-offset);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}

.pros .block-title {
  color: var(--color-green);
}

.cons .block-title {
  color: var(--color-red);
}

/* ============================================================
   CRT PHASES
   ============================================================ */
.crt-phases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  margin-top: var(--space-5);
}

.crt-phase {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  position: relative;
  transition: all var(--transition-interactive);
}

.crt-phase:hover {
  border-color: var(--color-gold);
  transform: translateY(-2px);
}

.crt-phase-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background-color: var(--color-gold);
  color: var(--color-bg);
  border-radius: var(--radius-full);
  font-family: var(--font-display);
  font-weight: 800;
  font-size: var(--text-sm);
  margin-bottom: var(--space-3);
}

.crt-phase-title {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.crt-phase p {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
}

.crt-phase p strong {
  color: var(--color-gold);
}

/* ============================================================
   CHART FIGURES
   ============================================================ */
.chart-figure {
  margin-top: var(--space-8);
  margin-bottom: var(--space-4);
  text-align: center;
}

.chart-figure img {
  width: 100%;
  max-width: 800px;
  margin: 0 auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-md);
  transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
}

.chart-figure img:hover {
  transform: scale(1.02);
  box-shadow: var(--shadow-lg);
}

.chart-figure figcaption {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  margin-top: var(--space-3);
  text-align: center;
  max-width: 60ch;
  margin-left: auto;
  margin-right: auto;
}

.chart-grid-2-images {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-top: var(--space-6);
}

.chart-grid-2-images .chart-figure {
  margin-top: 0;
}

/* ============================================================
   CHECKLIST
   ============================================================ */
.checklist-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-5);
}

.checklist-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  border-top: 3px solid var(--color-gold);
  transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth), transform var(--transition-smooth);
}

.checklist-card:hover {
  border-color: var(--color-gold);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.checklist-title {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-4);
  font-family: var(--font-display);
}

.checklist-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.checkbox {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  cursor: pointer;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  user-select: none;
  line-height: 1.5;
}

.checkbox input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.checkmark {
  position: relative;
  width: 20px;
  height: 20px;
  background-color: var(--color-surface-offset);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  transition: all var(--transition-interactive);
}

.checkbox:hover .checkmark {
  border-color: var(--color-gold);
}

.checkbox input:checked ~ .checkmark {
  background-color: var(--color-gold);
  border-color: var(--color-gold);
}

.checkmark::after {
  content: '';
  position: absolute;
  opacity: 0;
  left: 5px;
  top: 1px;
  width: 5px;
  height: 10px;
  border: solid var(--color-bg);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
  transition: opacity var(--transition-interactive);
}

.checkbox input:checked ~ .checkmark::after {
  opacity: 1;
}

.checkbox input:checked ~ span:last-child,
.checkbox:has(input:checked) {
  color: var(--color-text-muted);
}

/* ============================================================
   ERRORS GRID
   ============================================================ */
.errors-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
}

.error-card {
  display: flex;
  gap: var(--space-4);
  align-items: flex-start;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-red);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  transition: all var(--transition-interactive);
}

.error-card:hover {
  border-color: var(--color-red);
  transform: translateX(6px);
  box-shadow: var(--shadow-md), 0 0 20px color-mix(in oklab, var(--color-red) 10%, transparent);
}

.error-num {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-red);
  line-height: 1;
  flex-shrink: 0;
  opacity: 0.7;
}

.error-title {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.error-card p {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* ============================================================
   SOURCES
   ============================================================ */
.sources-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.sources-list li {
  padding: var(--space-3) var(--space-4);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  transition: all var(--transition-interactive);
}

.sources-list li:hover {
  border-color: var(--color-gold);
}

.sources-list a {
  font-weight: 600;
}

/* ============================================================
   FOOTER
   ============================================================ */
.footer {
  padding: var(--space-12) var(--space-12);
  background-color: var(--color-surface);
  border-top: 1px solid var(--color-border);
}

.footer-content {
  max-width: 700px;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.footer-brand .logo-icon {
  width: 28px;
  height: 28px;
}

.footer-brand-text {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-base);
  color: var(--color-text);
}

.footer-disclaimer {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  line-height: 1.7;
  margin-bottom: var(--space-4);
  max-width: 70ch;
}

.footer-disclaimer strong {
  color: var(--color-text-muted);
}

.footer-updated {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
}

/* ============================================================
   BACK TO TOP
   ============================================================ */
.back-to-top {
  position: fixed;
  bottom: var(--space-6);
  right: var(--space-6);
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-gold);
  color: var(--color-bg);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-lg);
  z-index: 90;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: all var(--transition-smooth);
}

.back-to-top.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.back-to-top:hover {
  background-color: var(--color-gold-hover);
  transform: translateY(-4px);
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px) {
  .card-grid-3 {
    grid-template-columns: repeat(2, 1fr);
  }
  .crt-phases {
    grid-template-columns: 1fr;
  }
  .checklist-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-100%);
  }

  .sidebar.active {
    transform: translateX(0);
    box-shadow: var(--shadow-lg);
  }

  .sidebar-close {
    display: flex;
  }

  .main-content {
    margin-left: 0;
  }

  .mobile-topbar {
    display: flex;
  }

  .section {
    padding: var(--space-10) var(--space-6);
  }

  .hero-section {
    padding: var(--space-16) var(--space-6);
    min-height: 80dvh;
  }

  .footer {
    padding: var(--space-10) var(--space-6);
  }
}

@media (max-width: 700px) {
  .card-grid-2,
  .card-grid-3 {
    grid-template-columns: 1fr;
  }

  .errors-grid {
    grid-template-columns: 1fr;
  }

  .checklist-grid {
    grid-template-columns: 1fr;
  }

  .strategy-pros-cons {
    grid-template-columns: 1fr;
  }

  .chart-grid-2-images {
    grid-template-columns: 1fr;
  }

  .strategy-header,
  .strategy-body {
    padding: var(--space-5);
  }

  .strategy-title-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .section-title {
    font-size: var(--text-xl);
  }

  .hero-title {
    font-size: var(--text-2xl);
  }

  .section {
    padding: var(--space-8) var(--space-4);
  }

  .hero-section {
    padding: var(--space-12) var(--space-4);
  }

  .footer {
    padding: var(--space-8) var(--space-4);
  }

  .back-to-top {
    width: 42px;
    height: 42px;
    bottom: var(--space-4);
    right: var(--space-4);
  }
}

@media (max-width: 480px) {
  .hero-badges {
    flex-direction: column;
    align-items: flex-start;
  }

  .crt-phase {
    padding: var(--space-4);
  }

  .rules-list-detailed li {
    font-size: var(--text-sm);
  }
}
